[
  {"name":"observe","description":"读取当前时间、任务、可用结论标签、答案字段及已知联系人。","parameters":{"type":"object","properties":{},"additionalProperties":false}},
  {"name":"search_public","description":"搜索本题的合成公开资料，空查询返回全部页面。","parameters":{"type":"object","properties":{"query":{"type":"string"}},"required":["query"],"additionalProperties":false}},
  {"name":"read_page","description":"打开公开页面，取得正文及联系人详情。","parameters":{"type":"object","properties":{"page_id":{"type":"string"}},"required":["page_id"],"additionalProperties":false}},
  {"name":"send_message","description":"向已发现的人物发送咨询、补材料或跟进。仅返回投递回执，正式回复稍后进收件箱。结构化fields填写已持有信息；case_id仅用于该事项补件或跟进。","parameters":{"type":"object","properties":{"recipient":{"type":"string"},"text":{"type":"string"},"fields":{"type":"object","additionalProperties":true},"channel":{"type":"string","enum":["email","chat","ticket"],"default":"email"},"case_id":{"type":"string"}},"required":["recipient","text"],"additionalProperties":false}},
  {"name":"read_inbox","description":"读取Agent自己收到的消息和证据；after为上一轮返回的cursor。","parameters":{"type":"object","properties":{"after":{"type":"integer","minimum":0,"default":0}},"additionalProperties":false}},
  {"name":"wait_until","description":"推进虚拟日历时间，最多到任务截止；默认收到对Agent可见消息就提前返回。时间必须使用含UTC偏移的ISO8601格式。","parameters":{"type":"object","properties":{"until":{"type":"string","format":"date-time"},"wake_on_message":{"type":"boolean","default":true}},"required":["until"],"additionalProperties":false}},
  {"name":"submit_answer","description":"最终提交一次答案。conclusion采用公开标签或中文名称；confirmed条目引用实际收到的证据，value支持公开归一化类型；unconfirmed不填写value和evidence_ids。claims覆盖公开answer_keys。","parameters":{"type":"object","properties":{"answer":{"type":"object","properties":{"conclusion":{"type":"string"},"claims":{"type":"array","items":{"type":"object","properties":{"key":{"type":"string"},"status":{"type":"string","enum":["confirmed","unconfirmed"]},"value":{},"evidence_ids":{"type":"array","items":{"type":"string"}}},"required":["key","status"],"additionalProperties":false}}},"required":["conclusion","claims"],"additionalProperties":false}},"required":["answer"],"additionalProperties":false}}
