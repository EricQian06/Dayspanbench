# Copy to .env and fill in your provider key. The evaluator never executes this file.
DSB_SIMULATOR_API_KEY=
DSB_SIMULATOR_BASE_URL=https://az.gptplus5.com/v1
DSB_SIMULATOR_MODEL=deepseek-v4-flash
# Optional: separate evaluated-model key. Otherwise share the simulator key only at the same base URL.
DSB_AGENT_API_KEY=
DSB_AGENT_BASE_URL=https://az.gptplus5.com/v1
